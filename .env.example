# Discord Bot Credentials
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_GUILD_ID=your_guild_id_here
OWNER_USER_ID=your_discord_user_id_here

# Database Configuration
# PostgreSQL format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# SQLite format (for local development): file:./dev.db
DATABASE_URL="file:./dev.db"

# System Settings
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Default Booking Configurations
DEFAULT_BUFFER_MINUTES=10
DEFAULT_WORKING_HOURS_START=08:00
DEFAULT_WORKING_HOURS_END=23:00
MISSED_REMINDER_THRESHOLD_MINUTES=15
